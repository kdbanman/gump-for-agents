/-
Every wrapped face of `rigour/geom.py` (`torus H K D`: the period lattice (H,K),(0,D) in the basis
E1 = (2,-2,0), E2 = (2,0,-2) of the layer; `GumpMath/DiceDef.lean`'s `torus`) is the kagome layer over the
finite group T = ℤ² / ⟨(H,K),(0,D)⟩, generated by the images of (1,0) and (0,1).  So the theorems of
`ChainKagome.lean` hold on every wrapped face:
  `torus_finite`       T is finite (every class has a representative in [0,H) × [0,D));
  `torus_generated`    T is generated by e1 = [(1,0)] and e2 = [(0,1)];
  `wrapped_lemma0`     Lemma 0, geometry included;
  `wrapped_one_price`  one price per orientation, log τ = HD (c_X + c_Y + c_Z);
  `wrapped_upper_bound` Theorem 1 with its constant, A = 3HD.
-/
import Mathlib
import GumpMath.ChainKagome

set_option linter.unusedSectionVars false

namespace Gump.Chain.Kagome
open Finset

/-- The period lattice (H,K),(0,D). -/
def lattice (H K D : ℤ) : AddSubgroup (ℤ × ℤ) := AddSubgroup.closure {(H, K), (0, D)}

/-- The translations of the wrapped face (H,K),(0,D). -/
abbrev Torus (H K D : ℤ) := (ℤ × ℤ) ⧸ lattice H K D

/-- The images of the unit cell's periods. -/
def te1 (H K D : ℤ) : Torus H K D := QuotientAddGroup.mk (1, 0)
def te2 (H K D : ℤ) : Torus H K D := QuotientAddGroup.mk (0, 1)

theorem torus_generated (H K D : ℤ) :
    AddSubgroup.closure ({te1 H K D, te2 H K D} : Set (Torus H K D)) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  induction x using QuotientAddGroup.induction_on with
  | H z =>
    obtain ⟨a, b⟩ := z
    have e : (QuotientAddGroup.mk (a, b) : Torus H K D) = a • te1 H K D + b • te2 H K D := by
      simp only [te1, te2, ← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_add]
      congr 1
      simp
    rw [e]
    exact add_mem (zsmul_mem (AddSubgroup.subset_closure (by simp)) a)
      (zsmul_mem (AddSubgroup.subset_closure (by simp)) b)

/-- Every class has a representative in [0,H) × [0,D). -/
theorem torus_finite (H K D : ℤ) (hH : 0 < H) (hD : 0 < D) : Finite (Torus H K D) := by
  let f : Fin H.toNat × Fin D.toNat → Torus H K D := fun p => QuotientAddGroup.mk ((p.1 : ℤ), (p.2 : ℤ))
  apply Finite.of_surjective f
  intro x
  induction x using QuotientAddGroup.induction_on with
  | H z =>
    obtain ⟨a, b⟩ := z
    set q := a / H
    set b' := b - q * K
    have ha0 : 0 ≤ a % H := Int.emod_nonneg a hH.ne'
    have ha1 : a % H < H := Int.emod_lt_of_pos a hH
    have hb0 : 0 ≤ b' % D := Int.emod_nonneg b' hD.ne'
    have hb1 : b' % D < D := Int.emod_lt_of_pos b' hD
    refine ⟨(⟨(a % H).toNat, by omega⟩, ⟨(b' % D).toNat, by omega⟩), ?_⟩
    simp only [f]
    rw [QuotientAddGroup.eq]
    have hmem : (-(((a % H).toNat : ℤ), ((b' % D).toNat : ℤ)) + (a, b) : ℤ × ℤ) =
        q • (H, K) + (b' / D) • (0, D) := by
      have e1 : (((a % H).toNat : ℤ)) = a % H := Int.toNat_of_nonneg ha0
      have e2 : (((b' % D).toNat : ℤ)) = b' % D := Int.toNat_of_nonneg hb0
      rw [e1, e2]
      have h1 := Int.mul_ediv_add_emod a H
      have h2 := Int.mul_ediv_add_emod b' D
      ext
      · simp only [Prod.fst_add, Prod.fst_neg, Prod.smul_fst, smul_eq_mul]; linarith
      · simp only [Prod.snd_add, Prod.snd_neg, Prod.smul_snd, smul_eq_mul]
        simp only [b'] at h2 ⊢; linarith
    show -(((a % H).toNat : ℤ), ((b' % D).toNat : ℤ)) + (a, b) ∈ lattice H K D
    rw [hmem]
    exact add_mem (zsmul_mem (AddSubgroup.subset_closure (by simp)) _)
      (zsmul_mem (AddSubgroup.subset_closure (by simp)) _)

/-- A finite enumeration of the torus exists (so the theorems below are not vacuous). -/
theorem torus_fintype (H K D : ℤ) (hH : 0 < H) (hD : 0 < D) : Nonempty (Fintype (Torus H K D)) :=
  ⟨@Fintype.ofFinite _ (torus_finite H K D hH hD)⟩

section Wrapped
variable (H K D : ℤ) [Fintype (Torus H K D)] [DecidableEq (Torus H K D)]
variable {ρ1 ρ2 : ℝ} (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1)

/-- **Lemma 0 on the wrapped face (H,K),(0,D)**, geometry included. -/
theorem wrapped_lemma0 :
    let C := (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').toSubsetChain
    Irreducible (C.killed.block C.canLive) ∧
    (∀ y, ¬ C.canLive y → ∀ z, C.killed.Q y z = 0) ∧
    (∀ y : Living (Cell (Torus H K D)), 0 < C.killed.Q ⟨uX, uX_nonempty⟩ y) ∧
    (∃ μ lam, C.killed.IsQSD μ lam ∧ 0 < lam ∧ (∀ x, 0 < μ x) ∧
      ∀ ν lam', C.killed.IsQSD ν lam' → 0 < lam' → ν = μ ∧ lam' = lam) :=
  kagome_lemma0 _ _ h1 h1' h2 h2' (torus_generated H K D)

/-- **One price per orientation on the wrapped face (H,K),(0,D).** -/
theorem wrapped_one_price :
    ∃ μ lam, (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.IsQSD μ lam ∧
      0 < lam ∧
      (∀ (o : Orient) (p q : Torus H K D),
        (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ (o, p) =
        (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ (o, q)) ∧
      Real.log ((kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.lifetime μ) =
        Fintype.card (Torus H K D) *
          ∑ o : Orient, (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ (o, 0) := by
  obtain ⟨μ, lam, hμ, hlam, -, hor, hlog⟩ :=
    kagome_one_price (te1 H K D) (te2 H K D) h1 h1' h2 h2' (torus_generated H K D)
  exact ⟨μ, lam, hμ, hlam, hor, hlog⟩

/-- **Theorem 1 on the wrapped face (H,K),(0,D)**: log τ ≤ ε_max · 3|T|. -/
theorem wrapped_upper_bound {μ : Living (Cell (Torus H K D)) → ℝ} {lam : ℝ}
    (hμ : (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.IsQSD μ lam) :
    Real.log ((kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.lifetime μ) ≤
      -Real.log (atomMin ρ1 ρ2) * (3 * Fintype.card (Torus H K D)) :=
  kagome_upper_bound _ _ h1 h1' h2 h2' hμ

end Wrapped
end Gump.Chain.Kagome

/-! ### Rotation-invariant wrapped faces -/

namespace Gump.Chain.Kagome
open Finset

/-- The rotation by 2π/3 in the basis E1, E2: (a, b) ↦ (b, -a - b). -/
def Rz : ℤ × ℤ ≃+ ℤ × ℤ where
  toFun z := (z.2, -z.1 - z.2)
  invFun z := (-z.1 - z.2, z.1)
  left_inv z := by ext <;> simp <;> ring
  right_inv z := by ext <;> simp <;> ring
  map_add' z w := by ext <;> simp <;> ring

theorem Rz_apply (z : ℤ × ℤ) : Rz z = (z.2, -z.1 - z.2) := rfl

theorem Rz_cube (z : ℤ × ℤ) : Rz (Rz (Rz z)) = z := by
  simp only [Rz_apply]; ext <;> simp <;> ring

theorem lattice_map_Rz (H K D : ℤ) (h1 : (K, -H - K) ∈ lattice H K D) (h2 : (D, -D) ∈ lattice H K D) :
    (lattice H K D).map (Rz : ℤ × ℤ →+ ℤ × ℤ) = lattice H K D := by
  have hle : (lattice H K D).map (Rz : ℤ × ℤ →+ ℤ × ℤ) ≤ lattice H K D := by
    rw [lattice, AddMonoidHom.map_closure, AddSubgroup.closure_le]
    rintro _ ⟨z, hz, rfl⟩
    rcases hz with rfl | rfl
    · simpa [Rz_apply, lattice] using h1
    · simpa [Rz_apply, lattice] using h2
  refine le_antisymm hle (fun x hx => ?_)
  have hR : ∀ y ∈ lattice H K D, Rz y ∈ lattice H K D := fun y hy =>
    hle ⟨y, hy, rfl⟩
  exact ⟨Rz (Rz x), hR _ (hR _ hx), Rz_cube x⟩

/-- **One price per cell on a rotation-invariant wrapped face**: if the period lattice (H,K),(0,D) is
invariant under the rotation by 2π/3 (it contains (K, -H-K) and (D, -D)), then c_X = c_Y = c_Z and
log τ = 3|T| · c.  Example: the 12-cell torus (2,0),(0,2). -/
theorem wrapped_rotation (H K D : ℤ) [Fintype (Torus H K D)] [DecidableEq (Torus H K D)]
    (hl1 : (K, -H - K) ∈ lattice H K D) (hl2 : (D, -D) ∈ lattice H K D)
    {ρ1 ρ2 : ℝ} (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1) :
    ∃ μ lam, (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.IsQSD μ lam ∧
      0 < lam ∧
      (∀ c c' : Cell (Torus H K D),
        (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ c =
        (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ c') ∧
      Real.log ((kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.lifetime μ) =
        3 * Fintype.card (Torus H K D) *
          (kernel (te1 H K D) (te2 H K D) ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ (Orient.X, 0) := by
  let R : Torus H K D ≃+ Torus H K D := QuotientAddGroup.congr _ _ Rz (lattice_map_Rz H K D hl1 hl2)
  have hR1 : R (te1 H K D) = -te2 H K D := by
    show (QuotientAddGroup.mk (Rz (1, 0)) : Torus H K D) = -QuotientAddGroup.mk (0, 1)
    rw [← QuotientAddGroup.mk_neg]; congr 1
  have hR2 : R (te2 H K D) = te1 H K D - te2 H K D := by
    show (QuotientAddGroup.mk (Rz (0, 1)) : Torus H K D) = QuotientAddGroup.mk (1, 0) - QuotientAddGroup.mk (0, 1)
    rw [← QuotientAddGroup.mk_sub]; congr 1
  exact kagome_rotation hR1 hR2 h1 h1' h2 h2' (torus_generated H K D)

/-- The 12-cell torus (2,0),(0,2) is rotation-invariant. -/
theorem torus_2_0_2_invariant : ((0 : ℤ), -2 - 0) ∈ lattice 2 0 2 ∧ ((2 : ℤ), -2) ∈ lattice 2 0 2 := by
  constructor
  · have : ((0 : ℤ), -2 - 0) = (-1 : ℤ) • ((0 : ℤ), (2 : ℤ)) := by ext <;> simp
    rw [this]
    exact zsmul_mem (AddSubgroup.subset_closure (by simp)) _
  · have : ((2 : ℤ), (-2 : ℤ)) = ((2 : ℤ), (0 : ℤ)) + (-1 : ℤ) • ((0 : ℤ), (2 : ℤ)) := by ext <;> simp
    rw [this]
    exact add_mem (AddSubgroup.subset_closure (by simp)) (zsmul_mem (AddSubgroup.subset_closure (by simp)) _)

end Gump.Chain.Kagome

namespace Gump.Chain.Kagome

/-- **The 12-cell torus (2,0),(0,2)** (`rigour/data/exact.csv`, ln τ = 3.9818365883 at (0.44, 0.42)): the
quasi-stationary law is unique, and its lifetime is exactly 12 equal local prices, log τ = 12 c. -/
theorem torus_2_0_2_one_price [Fintype (Torus 2 0 2)] [DecidableEq (Torus 2 0 2)]
    {ρ1 ρ2 : ℝ} (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1) :
    ∃ μ lam, (kernel (te1 2 0 2) (te2 2 0 2) ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.IsQSD μ lam ∧
      0 < lam ∧
      (∀ c c' : Cell (Torus 2 0 2),
        (kernel (te1 2 0 2) (te2 2 0 2) ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ c =
        (kernel (te1 2 0 2) (te2 2 0 2) ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ c') ∧
      Real.log ((kernel (te1 2 0 2) (te2 2 0 2) ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.lifetime μ) =
        3 * Fintype.card (Torus 2 0 2) *
          (kernel (te1 2 0 2) (te2 2 0 2) ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ (Orient.X, 0) :=
  wrapped_rotation 2 0 2 torus_2_0_2_invariant.1 torus_2_0_2_invariant.2 h1 h1' h2 h2'

end Gump.Chain.Kagome
