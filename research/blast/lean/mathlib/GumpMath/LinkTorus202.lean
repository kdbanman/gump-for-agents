theorem reach : reachOKF data (torus 2 0 2).A u (nxtT.get 12) (distT.get 12) = true := by decide +kernel

/-- The local death factors: each cell's own death probability. -/
noncomputable abbrev L := localDeath (torus 2 0 2) sdens hcells
def σ0 : List ℕ := [1, 0, 2, 10, 9, 11, 7, 6, 8, 4, 3, 5]
theorem sym0 : data.symOK (torus 2 0 2).A σ0 (Tree.build (torus 2 0 2).A (act σ0) 0) = true := by decide +kernel
def σ1 : List ℕ := [1, 2, 0, 7, 8, 6, 10, 11, 9, 4, 5, 3]
