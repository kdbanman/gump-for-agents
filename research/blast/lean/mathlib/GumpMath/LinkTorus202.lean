theorem price_all (i : Fin (torus 2 0 2).A) : L.price μ i = L.price μ ⟨0, hA⟩ := by
  rcases i with ⟨i, hi⟩
  have hi2 : i < 12 := lt_of_lt_of_eq hi hA12
  interval_cases i
  · exact price0 hμ hlam huniq hi hA
  · exact price1 hμ hlam huniq hi hA
  · exact price2 hμ hlam huniq hi hA
  · exact price3 hμ hlam huniq hi hA
  · exact price4 hμ hlam huniq hi hA
  · exact price5 hμ hlam huniq hi hA
  · exact price6 hμ hlam huniq hi hA
  · exact price7 hμ hlam huniq hi hA
  · exact price8 hμ hlam huniq hi hA
  · exact price9 hμ hlam huniq hi hA
  · exact price10 hμ hlam huniq hi hA
  · exact price11 hμ hlam huniq hi hA

