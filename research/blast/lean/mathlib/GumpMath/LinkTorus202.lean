  (hμ : (chain (torus 2 0 2) sdens.dens).IsQSD μ lam) (hlam : 0 < lam)
  (huniq : ∀ ν lam', (chain (torus 2 0 2) sdens.dens).IsQSD ν lam' → 0 < lam' → ν = μ ∧ lam' = lam)
include hμ hlam huniq

/-- cell j's price equals its parent's in the spanning tree of the generators. -/
theorem price0 (h : 0 < (torus 2 0 2).A) (h0 : 0 < (torus 2 0 2).A) : L.price μ ⟨0, h⟩ = L.price μ ⟨0, h0⟩ := rfl
theorem price1 (h : 1 < (torus 2 0 2).A) (h0 : 0 < (torus 2 0 2).A) : L.price μ ⟨1, h⟩ = L.price μ ⟨0, h0⟩ := by
  have hp : 0 < (torus 2 0 2).A := by rw [hA12]; norm_num
  have s := price_sym (torus 2 0 2) data tab sym0 sdens hρ1 hρ2 hcells hμ hlam huniq ⟨0, hp⟩
  have e : cellPerm (torus 2 0 2) data sym0 ⟨0, hp⟩ = ⟨1, h⟩ := Fin.ext (show σ0.getD 0 0 = 1 by decide)
  rw [e] at s
  exact s.trans (price0 hμ hlam huniq hp h0)
