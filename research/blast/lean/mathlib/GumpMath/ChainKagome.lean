/-
Lemma 0 of `research/blast/rigour/THEOREMS.md` in full, geometry included, for the one-layer dice
surrogate on the kagome layer over every finite quotient of its translation lattice (every wrapped face).

The layer.  A cell is an orientation X, Y, Z and a translation p in a finite abelian group T generated by
e1, e2 (the images of the unit cell's two periods; for the wrapped face (H,K),(0,D), T = ℤ²/⟨(H,K),(0,D)⟩).
Its six in-layer neighbours, two of each orientation (read off `docs/AUTOMATON.md`'s offsets in the layer
x + y + z = 1 with E1 = (2,-2,0), E2 = (2,0,-2), the coordinates of `rigour/geom.py` and `GumpMath/DiceDef.lean`):
  X(p): X(p - e1 + e2), X(p + e1 - e2), Y(p), Y(p + e1), Z(p), Z(p + e2)
  Y(p): Y(p + e2), Y(p - e2), X(p), X(p - e1), Z(p), Z(p - e1 + e2)
  Z(p): Z(p + e1), Z(p - e1), X(p), X(p - e2), Y(p), Y(p + e1 - e2)
counted with multiplicity on small tori.  Every cell has three coins (2 of density ρ1, 1 of density ρ2).

`kagome_lemma0`: for all 0 < ρ1, ρ2 < 1 the states some cell of which can be alive next form one irreducible
class, the all-X state u is in it with Q u u > 0, every other non-empty state dies surely and is entered
from u, and the quasi-stationary law with λ > 0 is unique and charges every non-empty state.

The proof differs from the source's step (4) (grow a line, then the Y cells beside it): from the X cells
over a set Q, one generation adds the Y cells beside them (each has a live X neighbour and at most two), and
the next keeps Q and adds the X cells over Q ± e1 (each has a live Y neighbour, and no cell has more than
four live neighbours); with Z cells, Q ± e2.  Since e1, e2 generate T, the X cells over all of T follow.
-/
import Mathlib
import GumpMath.ChainLemma0
import GumpMath.ChainCoins

set_option linter.unusedSectionVars false

namespace Gump.Chain.Kagome
open Finset Relation

/-- The three orientations of a cell (its normal axis). -/
inductive Orient | X | Y | Z
  deriving DecidableEq

instance : Fintype Orient := ⟨{Orient.X, Orient.Y, Orient.Z}, fun o => by cases o <;> simp⟩

variable {T : Type*} [AddCommGroup T] [Fintype T] [DecidableEq T]

/-- A cell of the layer: an orientation and a translation. -/
abbrev Cell (T : Type*) := Orient × T

variable (e1 e2 : T)

/-- The six in-layer neighbours, with multiplicity. -/
def nbrs : Cell T → List (Cell T)
  | (.X, p) => [(.X, p - e1 + e2), (.X, p + e1 - e2), (.Y, p), (.Y, p + e1), (.Z, p), (.Z, p + e2)]
  | (.Y, p) => [(.Y, p + e2), (.Y, p - e2), (.X, p), (.X, p - e1), (.Z, p), (.Z, p - e1 + e2)]
  | (.Z, p) => [(.Z, p + e1), (.Z, p - e1), (.X, p), (.X, p - e2), (.Y, p), (.Y, p + e1 - e2)]

/-- The number of live in-layer neighbours. -/
def k (x : Finset (Cell T)) (c : Cell T) : ℕ := (nbrs e1 e2 c).countP (fun d => decide (d ∈ x))

theorem length_nbrs (c : Cell T) : (nbrs e1 e2 c).length = 6 := by
  rcases c with ⟨o, p⟩; cases o <;> rfl

theorem k_le_six (x : Finset (Cell T)) (c : Cell T) : k e1 e2 x c ≤ 6 :=
  (List.countP_le_length).trans (length_nbrs e1 e2 c).le

theorem count_orient (c : Cell T) (o : Orient) :
    (nbrs e1 e2 c).countP (fun d => decide (d.1 = o)) = 2 := by
  rcases c with ⟨o', p⟩; cases o' <;> cases o <;> simp [nbrs]

theorem count_not_orient (c : Cell T) (o : Orient) :
    (nbrs e1 e2 c).countP (fun d => decide (d.1 ≠ o)) = 4 := by
  rcases c with ⟨o', p⟩; cases o' <;> cases o <;> simp [nbrs]

/-- A state of one orientation gives every cell at most two live neighbours. -/
theorem k_le_two {x : Finset (Cell T)} {o : Orient} (hx : ∀ d ∈ x, d.1 = o) (c : Cell T) :
    k e1 e2 x c ≤ 2 := by
  rw [← count_orient e1 e2 c o]
  exact List.countP_mono_left (fun d _ h => by simp only [decide_eq_true_eq] at h ⊢; exact hx d h)

/-- A state missing one orientation gives every cell at most four live neighbours. -/
theorem k_le_four {x : Finset (Cell T)} {o : Orient} (hx : ∀ d ∈ x, d.1 ≠ o) (c : Cell T) :
    k e1 e2 x c ≤ 4 := by
  rw [← count_not_orient e1 e2 c o]
  exact List.countP_mono_left (fun d _ h => by simp only [decide_eq_true_eq] at h ⊢; exact hx d h)

theorem one_le_k {x : Finset (Cell T)} {c d : Cell T} (hd : d ∈ nbrs e1 e2 c) (hx : d ∈ x) :
    1 ≤ k e1 e2 x c :=
  List.countP_pos_iff.2 ⟨d, hd, by simpa using hx⟩

/-! ### One cell with three coins -/

section Coins
variable {ρ1 ρ2 : ℝ}

theorem coin3_pos (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1) (b : ℕ) (hb : b < 4) :
    0 < coin3 ρ1 ρ2 b := by
  have a1 : 0 < 1 - ρ1 := by linarith
  have a2 : 0 < 1 - ρ2 := by linarith
  interval_cases b <;> simp only [coin3] <;> positivity

theorem one_sub_death3 (s : Bool) (k : ℕ) :
    1 - death3 ρ1 ρ2 s k = ∑ b ∈ range 4, if aliveNext s (k + b) then coin3 ρ1 ρ2 b else 0 := by
  have ht := coin3_total ρ1 ρ2
  have : death3 ρ1 ρ2 s k + ∑ b ∈ range 4, (if aliveNext s (k + b) then coin3 ρ1 ρ2 b else 0) =
      ∑ b ∈ range 4, coin3 ρ1 ρ2 b := by
    rw [death3, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun b _ => by split_ifs <;> ring)
  linarith

theorem death3_le_one (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1) (s : Bool) (k : ℕ) :
    death3 ρ1 ρ2 s k ≤ 1 := by
  have := one_sub_death3 (ρ1 := ρ1) (ρ2 := ρ2) s k
  have : 0 ≤ ∑ b ∈ range 4, (if aliveNext s (k + b) then coin3 ρ1 ρ2 b else 0) :=
    Finset.sum_nonneg (fun b hb => by
      split_ifs
      · exact (coin3_pos h1 h1' h2 h2' b (mem_range.1 hb)).le
      · exact le_refl _)
  linarith

/-- A cell can be alive next iff some number of heads puts n = k + b in the rule's window. -/
theorem alive_pos_iff (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1) (s : Bool) (k : ℕ) :
    0 < 1 - death3 ρ1 ρ2 s k ↔ ∃ b, b < 4 ∧ aliveNext s (k + b) = true := by
  rw [one_sub_death3]
  constructor
  · intro h
    by_contra hc
    push Not at hc
    have : ∑ b ∈ range 4, (if aliveNext s (k + b) then coin3 ρ1 ρ2 b else 0) = 0 :=
      Finset.sum_eq_zero (fun b hb => by
        have := hc b (mem_range.1 hb)
        simp [this])
    linarith
  · rintro ⟨b, hb, hab⟩
    apply lt_of_lt_of_le _ (single_le_sum (f := fun b => if aliveNext s (k + b) then coin3 ρ1 ρ2 b else 0)
      (fun b hb => by
        split_ifs
        · exact (coin3_pos h1 h1' h2 h2' b (mem_range.1 hb)).le
        · exact le_refl _) (mem_range.2 hb))
    simp only [hab, ite_true]
    exact coin3_pos h1 h1' h2 h2' b hb

/-- The window: a live cell can survive iff k ≤ 5; a dead one can be born iff 1 ≤ k ≤ 5 (k ≤ 6). -/
theorem window_iff (s : Bool) (k : ℕ) (hk : k ≤ 6) :
    (∃ b, b < 4 ∧ aliveNext s (k + b) = true) ↔ (if s then k ≤ 5 else 1 ≤ k ∧ k ≤ 5) := by
  interval_cases k <;> cases s <;> decide

end Coins

/-! ### The surrogate on the layer -/

/-- The surrogate's product kernel on the kagome layer over T. -/
noncomputable def kernel (ρ1 ρ2 : ℝ) (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1) :
    ProductKernel (Cell T) where
  a := fun c x => 1 - death3 ρ1 ρ2 (decide (c ∈ x)) (k e1 e2 x c)
  nonneg := fun c x => by linarith [death3_le_one h1 h1' h2 h2' (decide (c ∈ x)) (k e1 e2 x c)]
  lt_one := fun c x => by
    have := threeCoins_death_ge h1.le h1'.le h2.le h2'.le (decide (c ∈ x)) (k e1 e2 x c) (k_le_six e1 e2 x c)
    have := atomMin_pos h1 h1' h2 h2'
    linarith

/-- The combinatorial condition "c can be alive next from x". -/
def CanAlive (x : Finset (Cell T)) (c : Cell T) : Prop :=
  if c ∈ x then k e1 e2 x c ≤ 5 else 1 ≤ k e1 e2 x c ∧ k e1 e2 x c ≤ 5

theorem mem_M_iff {ρ1 ρ2 : ℝ} (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1)
    (x : Finset (Cell T)) (c : Cell T) :
    c ∈ (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').M x ↔ CanAlive e1 e2 x c := by
  rw [ProductKernel.M, Finset.mem_filter]
  simp only [mem_univ, true_and]
  show 0 < 1 - death3 ρ1 ρ2 (decide (c ∈ x)) (k e1 e2 x c) ↔ _
  rw [alive_pos_iff h1 h1' h2 h2', window_iff _ _ (k_le_six e1 e2 x c)]
  by_cases hc : c ∈ x <;> simp [CanAlive, hc]

theorem canAlive_of (x : Finset (Cell T)) (c : Cell T) (h5 : k e1 e2 x c ≤ 5)
    (h : c ∈ x ∨ 1 ≤ k e1 e2 x c) : CanAlive e1 e2 x c := by
  unfold CanAlive
  split_ifs with hc
  · exact h5
  · exact ⟨h.resolve_left hc, h5⟩

/-- The X cells over Q. -/
def SX (Q : Finset T) : Finset (Cell T) := Q.image (fun q => (Orient.X, q))
/-- The Y cells beside them. -/
def SY (Q : Finset T) : Finset (Cell T) :=
  (univ.filter (fun q => q ∈ Q ∨ q - e1 ∈ Q)).image (fun q => (Orient.Y, q))
/-- The Z cells beside them. -/
def SZ (Q : Finset T) : Finset (Cell T) :=
  (univ.filter (fun q => q ∈ Q ∨ q - e2 ∈ Q)).image (fun q => (Orient.Z, q))

/-- One round of growth along e1. -/
def grow1 (Q : Finset T) : Finset T := Q ∪ Q.image (· + e1) ∪ Q.image (· - e1)
/-- One round of growth along e2. -/
def grow2 (Q : Finset T) : Finset T := Q ∪ Q.image (· + e2) ∪ Q.image (· - e2)

section Steps
variable {ρ1 ρ2 : ℝ} (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1)

/-- A step of the subset chain, from the combinatorial condition. -/
theorem step_of {x y : Finset (Cell T)} (hy : y.Nonempty) (h : ∀ c ∈ y, CanAlive e1 e2 x c) :
    (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.Step x y :=
  ⟨hy, fun c hc => (mem_M_iff e1 e2 h1 h1' h2 h2' x c).2 (h c hc)⟩

theorem reach_grow1 (Q : Finset T) (hQ : Q.Nonempty) :
    ReflTransGen (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.Step (SX Q) (SX (grow1 e1 Q)) := by
  obtain ⟨q0, hq0⟩ := hQ
  have hx1 : ∀ d ∈ SX Q, d.1 = Orient.X := fun d hd => by
    obtain ⟨q, -, rfl⟩ := mem_image.1 hd; rfl
  have hx2 : ∀ d ∈ SX Q ∪ SY e1 Q, d.1 ≠ Orient.Z := fun d hd => by
    rcases mem_union.1 hd with h | h
    · obtain ⟨q, -, rfl⟩ := mem_image.1 h; simp
    · obtain ⟨q, -, rfl⟩ := mem_image.1 h; simp
  refine ReflTransGen.head (b := SX Q ∪ SY e1 Q) ?_ (ReflTransGen.single ?_)
  · refine step_of e1 e2 h1 h1' h2 h2' ⟨_, mem_union_left _ (mem_image_of_mem _ hq0)⟩ (fun c hc => ?_)
    apply canAlive_of e1 e2 _ _ ((k_le_two e1 e2 hx1 c).trans (by norm_num))
    rcases mem_union.1 hc with h | h
    · exact Or.inl h
    · right
      obtain ⟨q, hq, rfl⟩ := mem_image.1 h
      rcases (mem_filter.1 hq).2 with hq | hq
      · exact one_le_k e1 e2 (d := (Orient.X, q)) (by simp [nbrs]) (mem_image_of_mem _ hq)
      · exact one_le_k e1 e2 (d := (Orient.X, q - e1)) (by simp [nbrs]) (mem_image_of_mem _ hq)
  · refine step_of e1 e2 h1 h1' h2 h2'
      ⟨(Orient.X, q0), mem_image_of_mem _ (show q0 ∈ grow1 e1 Q by simp [grow1, hq0])⟩ (fun c hc => ?_)
    apply canAlive_of e1 e2 _ _ ((k_le_four e1 e2 hx2 c).trans (by norm_num))
    obtain ⟨p, hp, rfl⟩ := mem_image.1 hc
    simp only [grow1, mem_union, mem_image] at hp
    rcases hp with (hp | ⟨q, hq, rfl⟩) | ⟨q, hq, rfl⟩
    · exact Or.inl (mem_union_left _ (mem_image_of_mem _ hp))
    · right
      refine one_le_k e1 e2 (d := (Orient.Y, q + e1)) (by simp [nbrs]) (mem_union_right _ ?_)
      exact mem_image.2 ⟨q + e1, by simp [hq], rfl⟩
    · right
      refine one_le_k e1 e2 (d := (Orient.Y, q)) (by simp [nbrs]) (mem_union_right _ ?_)
      exact mem_image.2 ⟨q, by simp [hq], rfl⟩

theorem reach_grow2 (Q : Finset T) (hQ : Q.Nonempty) :
    ReflTransGen (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.Step (SX Q) (SX (grow2 e2 Q)) := by
  obtain ⟨q0, hq0⟩ := hQ
  have hx1 : ∀ d ∈ SX Q, d.1 = Orient.X := fun d hd => by
    obtain ⟨q, -, rfl⟩ := mem_image.1 hd; rfl
  have hx2 : ∀ d ∈ SX Q ∪ SZ e2 Q, d.1 ≠ Orient.Y := fun d hd => by
    rcases mem_union.1 hd with h | h
    · obtain ⟨q, -, rfl⟩ := mem_image.1 h; simp
    · obtain ⟨q, -, rfl⟩ := mem_image.1 h; simp
  refine ReflTransGen.head (b := SX Q ∪ SZ e2 Q) ?_ (ReflTransGen.single ?_)
  · refine step_of e1 e2 h1 h1' h2 h2' ⟨_, mem_union_left _ (mem_image_of_mem _ hq0)⟩ (fun c hc => ?_)
    apply canAlive_of e1 e2 _ _ ((k_le_two e1 e2 hx1 c).trans (by norm_num))
    rcases mem_union.1 hc with h | h
    · exact Or.inl h
    · right
      obtain ⟨q, hq, rfl⟩ := mem_image.1 h
      rcases (mem_filter.1 hq).2 with hq | hq
      · exact one_le_k e1 e2 (d := (Orient.X, q)) (by simp [nbrs]) (mem_image_of_mem _ hq)
      · exact one_le_k e1 e2 (d := (Orient.X, q - e2)) (by simp [nbrs]) (mem_image_of_mem _ hq)
  · refine step_of e1 e2 h1 h1' h2 h2'
      ⟨(Orient.X, q0), mem_image_of_mem _ (show q0 ∈ grow2 e2 Q by simp [grow2, hq0])⟩ (fun c hc => ?_)
    apply canAlive_of e1 e2 _ _ ((k_le_four e1 e2 hx2 c).trans (by norm_num))
    obtain ⟨p, hp, rfl⟩ := mem_image.1 hc
    simp only [grow2, mem_union, mem_image] at hp
    rcases hp with (hp | ⟨q, hq, rfl⟩) | ⟨q, hq, rfl⟩
    · exact Or.inl (mem_union_left _ (mem_image_of_mem _ hp))
    · right
      refine one_le_k e1 e2 (d := (Orient.Z, q + e2)) (by simp [nbrs]) (mem_union_right _ ?_)
      exact mem_image.2 ⟨q + e2, by simp [hq], rfl⟩
    · right
      refine one_le_k e1 e2 (d := (Orient.Z, q)) (by simp [nbrs]) (mem_union_right _ ?_)
      exact mem_image.2 ⟨q, by simp [hq], rfl⟩

end Steps

/-- Growth in both directions. -/
def grow (Q : Finset T) : Finset T := grow2 e2 (grow1 e1 Q)

theorem subset_grow (Q : Finset T) : Q ⊆ grow e1 e2 Q := fun q hq => by
  simp [grow, grow2, grow1, hq]

/-- The growth stabilises at the whole group. -/
theorem grow_iter_univ (hgen : AddSubgroup.closure ({e1, e2} : Set T) = ⊤) (p0 : T) :
    ∃ n, (grow e1 e2)^[n] {p0} = univ := by
  -- a fixed point exists, since the iterates increase in a finite type
  have hmono : ∀ n, (grow e1 e2)^[n] {p0} ⊆ (grow e1 e2)^[n + 1] {p0} := fun n => by
    rw [Function.iterate_succ_apply']; exact subset_grow e1 e2 _
  have hfix : ∃ n, (grow e1 e2)^[n + 1] {p0} = (grow e1 e2)^[n] {p0} := by
    by_contra h
    push Not at h
    have hlt : ∀ n, n ≤ ((grow e1 e2)^[n] {p0}).card := fun n => by
      induction n with
      | zero => simp
      | succ n ih =>
        have := Finset.card_lt_card (Finset.ssubset_iff_subset_ne.2 ⟨hmono n, (h n).symm⟩)
        omega
    have := (hlt (Fintype.card T + 1)).trans (card_le_univ _)
    omega
  obtain ⟨n, hn⟩ := hfix
  refine ⟨n, ?_⟩
  set G := (grow e1 e2)^[n] {p0} with hG
  have hclosed : grow e1 e2 G = G := by rw [← Function.iterate_succ_apply' (grow e1 e2) n]; exact hn
  have he1 : ∀ q ∈ G, q + e1 ∈ G := fun q hq => by
    rw [← hclosed]; simp [grow, grow2, grow1, hq]
  have he2 : ∀ q ∈ G, q + e2 ∈ G := fun q hq => by
    rw [← hclosed]
    have hq' : q ∈ grow1 e1 G := mem_union_left _ (mem_union_left _ hq)
    exact mem_union_left _ (mem_union_right _ (mem_image_of_mem (· + e2) hq'))
  -- every element of the closure translates G into itself
  have key : ∀ t ∈ AddSubgroup.closure ({e1, e2} : Set T), ∀ q ∈ G, q + t ∈ G := by
    intro t ht
    induction ht using AddSubgroup.closure_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact he1
      · exact fun q hq => he2 q hq
    | zero => simp
    | add x y _ _ hx hy => exact fun q hq => by rw [← add_assoc]; exact hy _ (hx q hq)
    | neg x _ hx =>
      have hm : ∀ m : ℕ, ∀ q ∈ G, q + m • x ∈ G := fun m => by
        induction m with
        | zero => simp
        | succ m ih => exact fun q hq => by rw [succ_nsmul, ← add_assoc]; exact hx _ (ih q hq)
      have e : -x = (Fintype.card T - 1) • x := by
        have h0 : Fintype.card T • x = 0 := card_nsmul_eq_zero
        have hc : 1 ≤ Fintype.card T := Fintype.card_pos
        have : (Fintype.card T - 1) • x + x = 0 := by
          rw [← succ_nsmul, Nat.sub_add_cancel hc, h0]
        exact (neg_eq_of_add_eq_zero_left this)
      intro q hq; rw [e]; exact hm _ q hq
  have hp0 : p0 ∈ G := by
    have : ∀ m, p0 ∈ (grow e1 e2)^[m] {p0} := fun m => by
      induction m with
      | zero => simp
      | succ m ih => exact hmono m ih
    exact this n
  ext q
  simp only [mem_univ, iff_true]
  have := key (q - p0) (by rw [hgen]; exact AddSubgroup.mem_top _) p0 hp0
  simpa using this

/-- The all-X state. -/
def uX : Finset (Cell T) := SX (univ : Finset T)

theorem uX_nonempty : (uX : Finset (Cell T)).Nonempty := ⟨(Orient.X, 0), by simp [uX, SX]⟩

section Main
variable {ρ1 ρ2 : ℝ} (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1)

/-- In the all-X state every cell can be alive next (every cell has exactly... at least one and at most
two live neighbours): M(u) = V, step (3). -/
theorem M_uX : (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.M uX = univ := by
  ext c
  simp only [mem_univ, iff_true]
  show c ∈ (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').M uX
  rw [mem_M_iff e1 e2 h1 h1' h2 h2']
  have hx : ∀ d ∈ (uX : Finset (Cell T)), d.1 = Orient.X := fun d hd => by
    obtain ⟨q, -, rfl⟩ := mem_image.1 hd; rfl
  apply canAlive_of e1 e2 _ _ ((k_le_two e1 e2 hx c).trans (by norm_num))
  right
  rcases c with ⟨o, p⟩
  have hX : ∀ q, ((Orient.X, q) : Cell T) ∈ uX := fun q => mem_image_of_mem _ (mem_univ q)
  cases o
  · exact one_le_k e1 e2 (d := (Orient.X, p - e1 + e2)) (by simp [nbrs]) (hX _)
  · exact one_le_k e1 e2 (d := (Orient.X, p)) (by simp [nbrs]) (hX _)
  · exact one_le_k e1 e2 (d := (Orient.X, p)) (by simp [nbrs]) (hX _)

/-- Every singleton reaches the all-X state. -/
theorem singleton_reach (hgen : AddSubgroup.closure ({e1, e2} : Set T) = ⊤) (c : Cell T) :
    ReflTransGen (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.Step {c} uX := by
  -- from the X cell over a point to the X cells over everything
  have hX : ∀ p0 : T, ReflTransGen (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.Step
      (SX {p0}) uX := by
    intro p0
    obtain ⟨n, hn⟩ := grow_iter_univ e1 e2 hgen p0
    have : ∀ m, ReflTransGen (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.Step
        (SX {p0}) (SX ((grow e1 e2)^[m] {p0})) := by
      intro m
      induction m with
      | zero => exact ReflTransGen.refl
      | succ m ih =>
        rw [Function.iterate_succ_apply']
        have hne : ((grow e1 e2)^[m] {p0}).Nonempty := by
          have : ∀ j, p0 ∈ (grow e1 e2)^[j] {p0} := fun j => by
            induction j with
            | zero => simp
            | succ j ihj => rw [Function.iterate_succ_apply']; exact subset_grow e1 e2 _ ihj
          exact ⟨p0, this m⟩
        have hne1 : (grow1 e1 ((grow e1 e2)^[m] {p0})).Nonempty :=
          hne.mono (fun q hq => by simp [grow1, hq])
        exact ih.trans ((reach_grow1 e1 e2 h1 h1' h2 h2' _ hne).trans
          (reach_grow2 e1 e2 h1 h1' h2 h2' _ hne1))
    have := this n
    rwa [hn] at this
  rcases c with ⟨o, p⟩
  have hs : SX {p} = ({(Orient.X, p)} : Finset (Cell T)) := by simp [SX]
  cases o
  · rw [← hs]; exact hX p
  · refine ReflTransGen.head ?_ (hs ▸ hX p)
    refine step_of e1 e2 h1 h1' h2 h2' (singleton_nonempty _) (fun c hc => ?_)
    rw [mem_singleton.1 hc]
    apply canAlive_of e1 e2 _ _ ((k_le_two e1 e2 (o := Orient.Y) (by simp) _).trans (by norm_num))
    exact Or.inr (one_le_k e1 e2 (d := (Orient.Y, p)) (by simp [nbrs]) (mem_singleton_self _))
  · refine ReflTransGen.head ?_ (hs ▸ hX p)
    refine step_of e1 e2 h1 h1' h2 h2' (singleton_nonempty _) (fun c hc => ?_)
    rw [mem_singleton.1 hc]
    apply canAlive_of e1 e2 _ _ ((k_le_two e1 e2 (o := Orient.Z) (by simp) _).trans (by norm_num))
    exact Or.inr (one_le_k e1 e2 (d := (Orient.Z, p)) (by simp [nbrs]) (mem_singleton_self _))

/-- **Lemma 0 on every wrapped face**: for the surrogate on the kagome layer over a finite abelian group
generated by e1, e2, and every 0 < ρ1, ρ2 < 1: one irreducible class of the states some cell of which can
be alive next, containing the all-X state u with Q u u > 0; every other non-empty state dies surely and is
entered from u; and exactly one quasi-stationary law with λ > 0, charging every non-empty state. -/
theorem kagome_lemma0 (hgen : AddSubgroup.closure ({e1, e2} : Set T) = ⊤) :
    let C := (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain
    Irreducible (C.killed.block C.canLive) ∧
    (∀ y, ¬ C.canLive y → ∀ z, C.killed.Q y z = 0) ∧
    (∀ y : Living (Cell T), 0 < C.killed.Q ⟨uX, uX_nonempty⟩ y) ∧
    (∃ μ lam, C.killed.IsQSD μ lam ∧ 0 < lam ∧ (∀ x, 0 < μ x) ∧
      ∀ ν lam', C.killed.IsQSD ν lam' → 0 < lam' → ν = μ ∧ lam' = lam) := by
  intro C
  have hu := M_uX e1 e2 h1 h1' h2 h2'
  have hsing : ∀ i j : Cell T, ReflTransGen C.Step {i} {j} := fun i j =>
    (singleton_reach e1 e2 h1 h1' h2 h2' hgen i).trans
      (ReflTransGen.single ⟨singleton_nonempty j, hu ▸ subset_univ _⟩)
  have hreach : ∃ i, ReflTransGen C.Step {i} uX := ⟨(Orient.X, 0), singleton_reach e1 e2 h1 h1' h2 h2' hgen _⟩
  have : Nonempty (Cell T) := ⟨(Orient.X, 0)⟩
  obtain ⟨hirr, hout, hin, -⟩ := C.lemma0 hsing uX uX_nonempty hu hreach
  exact ⟨hirr, hout, hin, C.lemma0_qsd hsing uX uX_nonempty hu hreach⟩

end Main
end Gump.Chain.Kagome

/-! ### One price per orientation on every wrapped face -/

namespace Gump.Chain.Kagome
open Finset Relation

variable {T : Type*} [AddCommGroup T] [Fintype T] [DecidableEq T] (e1 e2 : T)

/-- Translation of the layer by t. -/
def tr (t : T) : Cell T ≃ Cell T := Equiv.prodCongr (Equiv.refl Orient) (Equiv.addRight t)

theorem tr_apply (t : T) (c : Cell T) : tr t c = (c.1, c.2 + t) := rfl

theorem nbrs_tr (t : T) (c : Cell T) : nbrs e1 e2 (tr t c) = (nbrs e1 e2 c).map (tr t) := by
  rcases c with ⟨o, p⟩
  cases o <;> simp [nbrs, tr_apply, add_comm, add_left_comm, add_assoc, sub_eq_add_neg]

theorem k_tr (t : T) (x : Finset (Cell T)) (c : Cell T) :
    k e1 e2 (x.map (tr t).toEmbedding) (tr t c) = k e1 e2 x c := by
  unfold k
  rw [nbrs_tr, List.countP_map]
  congr 1
  funext d
  simp

section Price
variable {ρ1 ρ2 : ℝ} (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1)

theorem a_tr (t : T) (x : Finset (Cell T)) (c : Cell T) :
    (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').a (tr t c) (x.map (tr t).toEmbedding) =
      (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').a c x := by
  simp only [kernel, k_tr]
  congr 2
  simp

/-- Translation acting on the non-empty states. -/
def trState (t : T) : Living (Cell T) ≃ Living (Cell T) :=
  Equiv.subtypeEquiv (Equiv.finsetCongr (tr t)) (fun x => by
    simp [Equiv.finsetCongr_apply])

theorem trState_val (t : T) (x : Living (Cell T)) :
    ((trState t x : Living (Cell T)) : Finset (Cell T)) = x.1.map (tr t).toEmbedding := rfl

theorem P_tr (t : T) (x y : Finset (Cell T)) :
    (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').P (x.map (tr t).toEmbedding) (y.map (tr t).toEmbedding) =
      (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').P x y := by
  unfold ProductKernel.P
  rw [← Equiv.prod_comp (tr t)]
  refine Finset.prod_congr rfl (fun c _ => ?_)
  have hm : (tr t c ∈ y.map (tr t).toEmbedding) ↔ c ∈ y := by simp
  simp only [hm, a_tr]

/-- **One price per orientation, on every wrapped face**: for the unique quasi-stationary law of the
surrogate on the kagome layer over T, the price c_i of a cell depends only on its orientation, and
log τ = |T| · (c_X + c_Y + c_Z). -/
theorem kagome_one_price (hgen : AddSubgroup.closure ({e1, e2} : Set T) = ⊤) :
    ∃ μ lam, (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.IsQSD μ lam ∧ 0 < lam ∧
      (∀ ν lam', (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.IsQSD ν lam' → 0 < lam' →
        ν = μ ∧ lam' = lam) ∧
      (∀ (o : Orient) (p q : T), (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ (o, p) =
        (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ (o, q)) ∧
      Real.log ((kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.lifetime μ) =
        Fintype.card T * ∑ o : Orient, (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ (o, 0) := by
  obtain ⟨-, -, -, μ, lam, hμ, hlam, -, huniq⟩ := kagome_lemma0 e1 e2 h1 h1' h2 h2' hgen
  set G := kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2'
  have hinv : ∀ (t : T) (c : Cell T), G.localDeath.price μ (tr t c) = G.localDeath.price μ c := by
    intro t c
    refine KilledChain.price_invariant G.localDeath hμ hlam (fun ν lam' h h' => (huniq ν lam' h h').1)
      (trState t) (fun x y => ?_) (tr t) (fun i x => ?_) c
    · show G.P (trState t x).1 (trState t y).1 = G.P x.1 y.1
      rw [trState_val, trState_val, P_tr]
    · show 1 - G.a (tr t i) (trState t x).1 = 1 - G.a i x.1
      rw [trState_val, a_tr]
  have hor : ∀ (o : Orient) (p q : T), G.localDeath.price μ (o, p) = G.localDeath.price μ (o, q) := by
    intro o p q
    have := hinv (q - p) (o, p)
    rw [tr_apply] at this
    simp only [add_sub_cancel] at this
    exact this.symm
  refine ⟨μ, lam, hμ, hlam, huniq, hor, ?_⟩
  rw [(KilledChain.tilt_identity G.localDeath hμ).2.1]
  rw [Fintype.sum_prod_type, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun o _ => ?_)
  rw [Finset.sum_congr rfl (fun p _ => hor o p 0)]
  simp

end Price
end Gump.Chain.Kagome

/-! ### The rotation by 2π/3: one price per cell on equilateral tori -/

namespace Gump.Chain.Kagome
open Finset Relation

variable {T : Type*} [AddCommGroup T] [Fintype T] [DecidableEq T] (e1 e2 : T)

/-- The rotation (x, y, z) ↦ (y, z, x) of the layer x + y + z = 1 sends X cells to Z cells, Y to X, Z to Y. -/
def orot : Orient ≃ Orient where
  toFun o := match o with | .X => .Z | .Y => .X | .Z => .Y
  invFun o := match o with | .X => .Y | .Y => .Z | .Z => .X
  left_inv o := by cases o <;> rfl
  right_inv o := by cases o <;> rfl

variable (R : T ≃+ T)

/-- The rotation on cells, for an automorphism R of T with R e1 = -e2, R e2 = e1 - e2 (E1 ↦ -E2,
E2 ↦ E1 - E2 under (x,y,z) ↦ (y,z,x)). -/
def rot : Cell T ≃ Cell T := Equiv.prodCongr orot R.toEquiv

theorem rot_apply (c : Cell T) : rot R c = (orot c.1, R c.2) := rfl

variable {e1 e2 R} (hR1 : R e1 = -e2) (hR2 : R e2 = e1 - e2)
include hR1 hR2

theorem nbrs_rot_perm (c : Cell T) : (nbrs e1 e2 (rot R c)).Perm ((nbrs e1 e2 c).map (rot R)) := by
  rcases c with ⟨o, p⟩
  cases o
  · have h : (nbrs e1 e2 ((Orient.X, p) : Cell T)).map (rot R) = nbrs e1 e2 (rot R (Orient.X, p)) := by
      simp only [nbrs, List.map_cons, List.map_nil, rot_apply, orot, Equiv.coe_fn_mk, map_add, map_sub,
        hR1, hR2, List.cons.injEq, Prod.mk.injEq, true_and, and_true]
      repeat' constructor
      all_goals abel
    rw [h]
  · have h : (nbrs e1 e2 ((Orient.Y, p) : Cell T)).map (rot R) =
        [(Orient.X, R p + e1 - e2), (Orient.X, R p - e1 + e2), (Orient.Z, R p), (Orient.Z, R p + e2),
          (Orient.Y, R p), (Orient.Y, R p + e1)] := by
      simp only [nbrs, List.map_cons, List.map_nil, rot_apply, orot, Equiv.coe_fn_mk, map_add, map_sub,
        hR1, hR2, List.cons.injEq, Prod.mk.injEq, true_and, and_true]
      repeat' constructor
      all_goals abel
    rw [h]
    simp only [rot_apply, orot, Equiv.coe_fn_mk, nbrs]
    exact (((List.perm_append_comm (l₁ := [(Orient.Y, R p), (Orient.Y, R p + e1)])
      (l₂ := [(Orient.Z, R p), (Orient.Z, R p + e2)])).cons _).cons _).trans (List.Perm.swap _ _ _)
  · have h : (nbrs e1 e2 ((Orient.Z, p) : Cell T)).map (rot R) =
        [(Orient.Y, R p - e2), (Orient.Y, R p + e2), (Orient.Z, R p), (Orient.Z, R p - e1 + e2),
          (Orient.X, R p), (Orient.X, R p - e1)] := by
      simp only [nbrs, List.map_cons, List.map_nil, rot_apply, orot, Equiv.coe_fn_mk, map_add, map_sub,
        hR1, hR2, List.cons.injEq, Prod.mk.injEq, true_and, and_true]
      repeat' constructor
      all_goals abel
    rw [h]
    simp only [rot_apply, orot, Equiv.coe_fn_mk, nbrs]
    exact (((List.perm_append_comm (l₁ := [(Orient.X, R p), (Orient.X, R p - e1)])
      (l₂ := [(Orient.Z, R p), (Orient.Z, R p - e1 + e2)])).cons _).cons _).trans (List.Perm.swap _ _ _)

theorem k_rot (x : Finset (Cell T)) (c : Cell T) :
    k e1 e2 (x.map (rot R).toEmbedding) (rot R c) = k e1 e2 x c := by
  unfold k
  rw [(nbrs_rot_perm hR1 hR2 c).countP_eq, List.countP_map]
  congr 1
  funext d
  simp

section RotPrice
variable {ρ1 ρ2 : ℝ} (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1)
include h1 h1' h2 h2'

theorem a_rot (x : Finset (Cell T)) (c : Cell T) :
    (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').a (rot R c) (x.map (rot R).toEmbedding) =
      (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').a c x := by
  simp only [kernel, k_rot hR1 hR2]
  congr 2
  simp

theorem P_rot (x y : Finset (Cell T)) :
    (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').P (x.map (rot R).toEmbedding) (y.map (rot R).toEmbedding) =
      (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').P x y := by
  unfold ProductKernel.P
  rw [← Equiv.prod_comp (rot R)]
  refine Finset.prod_congr rfl (fun c _ => ?_)
  have hm : (rot R c ∈ y.map (rot R).toEmbedding) ↔ c ∈ y := by simp
  simp only [hm, a_rot hR1 hR2 h1 h1' h2 h2']

omit h1 h1' h2 h2' in
/-- The rotation acting on the non-empty states. -/
def rotState : Living (Cell T) ≃ Living (Cell T) :=
  Equiv.subtypeEquiv (Equiv.finsetCongr (rot R)) (fun x => by simp [Equiv.finsetCongr_apply])

/-- **One price per cell on tori invariant under the rotation by 2π/3**: if T has an automorphism R with
R e1 = -e2 and R e2 = e1 - e2, the three orientations have the same price c and log τ = 3|T| · c = A · c. -/
theorem kagome_rotation (hgen : AddSubgroup.closure ({e1, e2} : Set T) = ⊤) :
    ∃ μ lam, (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.IsQSD μ lam ∧ 0 < lam ∧
      (∀ c c' : Cell T, (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ c =
        (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ c') ∧
      Real.log ((kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.lifetime μ) =
        3 * Fintype.card T * (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').localDeath.price μ (Orient.X, 0) := by
  obtain ⟨μ, lam, hμ, hlam, huniq, hor, hlog⟩ := kagome_one_price e1 e2 h1 h1' h2 h2' hgen
  set G := kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2'
  have hrot : ∀ c : Cell T, G.localDeath.price μ (rot R c) = G.localDeath.price μ c := by
    intro c
    refine KilledChain.price_invariant G.localDeath hμ hlam (fun ν lam' h h' => (huniq ν lam' h h').1)
      (rotState (R := R)) (fun x y => ?_) (rot R) (fun i x => ?_) c
    · show G.P (x.1.map (rot R).toEmbedding) (y.1.map (rot R).toEmbedding) = G.P x.1 y.1
      rw [P_rot hR1 hR2]
    · show 1 - G.a (rot R i) (x.1.map (rot R).toEmbedding) = 1 - G.a i x.1
      rw [a_rot hR1 hR2]
  have hXZ : G.localDeath.price μ (Orient.Z, 0) = G.localDeath.price μ (Orient.X, 0) := by
    have := hrot (Orient.X, 0); simpa [rot_apply, orot] using this
  have hYX : G.localDeath.price μ (Orient.Y, 0) = G.localDeath.price μ (Orient.X, 0) := by
    have := hrot (Orient.Y, 0)
    simp only [rot_apply, orot, Equiv.coe_fn_mk, map_zero] at this
    exact this.symm
  have hall : ∀ c : Cell T, G.localDeath.price μ c = G.localDeath.price μ (Orient.X, 0) := by
    rintro ⟨o, p⟩
    rw [hor o p 0]
    cases o
    · rfl
    · exact hYX
    · exact hXZ
  refine ⟨μ, lam, hμ, hlam, fun c c' => by rw [hall c, hall c'], ?_⟩
  rw [hlog]
  have : ∑ o : Orient, G.localDeath.price μ (o, 0) = 3 * G.localDeath.price μ (Orient.X, 0) := by
    rw [Finset.sum_congr rfl (fun o _ => hall (o, 0))]
    simp
    left; rfl
  rw [this]; ring

end RotPrice
end Gump.Chain.Kagome

namespace Gump.Chain.Kagome
variable {T : Type*} [AddCommGroup T] [Fintype T] [DecidableEq T] (e1 e2 : T)

theorem card_orient : Fintype.card Orient = 3 := rfl

/-- **Theorem 1 with its constant on every wrapped face**: for every quasi-stationary law,
log τ ≤ -log min(ρ1²ρ2, (1-ρ1)²(1-ρ2)) · A with A = 3|T|; at (0.44, 0.42) this is ≤ 2.51 · A (`emax_main`). -/
theorem kagome_upper_bound {ρ1 ρ2 : ℝ} (h1 : 0 < ρ1) (h1' : ρ1 < 1) (h2 : 0 < ρ2) (h2' : ρ2 < 1)
    {μ : Living (Cell T) → ℝ} {lam : ℝ}
    (hμ : (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.IsQSD μ lam) :
    Real.log ((kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').toSubsetChain.killed.lifetime μ) ≤
      -Real.log (atomMin ρ1 ρ2) * (3 * Fintype.card T) := by
  have := KilledChain.upper_bound_coins (kernel e1 e2 ρ1 ρ2 h1 h1' h2 h2').localDeath hμ h1 h1' h2 h2'
    (fun i x => by
      show atomMin ρ1 ρ2 ≤ 1 - (1 - death3 ρ1 ρ2 (decide (i ∈ x.1)) (k e1 e2 x.1 i))
      rw [sub_sub_cancel]
      exact threeCoins_death_ge h1.le h1'.le h2.le h2'.le _ _ (k_le_six e1 e2 _ _))
  rw [Fintype.card_prod, card_orient] at this
  push_cast at this
  exact this

end Gump.Chain.Kagome
