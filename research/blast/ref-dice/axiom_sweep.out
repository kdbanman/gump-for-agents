Data.lifetime_of_cert : ∀ (c : Data) (F : Face) (Vu Vl : Gump.Dice.Tree) (Lu Mu Ll Ml vmin vmax wmax : ℕ),
  c.tabOK F = true →
    Data.allRows (c.rowUp F.A (c.Dt F.A) Lu Mu Vu) (2 ^ F.A) = true →
      Data.allRows (c.rowLo F.A (c.Dt F.A) Ll Ml Vl) (2 ^ F.A) = true →
        Data.vecOK Vu F.A vmin vmax = true →
          Data.vecOK Vl F.A 0 wmax = true →
            0 < Mu →
              0 < Ml →
                0 < vmin →
                  0 < wmax →
                    ∀ (t : ℕ),
                      (∀ (x : Fin (2 ^ F.A)),
                          Data.vec Vl F.A x / ↑wmax * (↑Ll / ↑Ml) ^ t ≤
                            F.survival (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2) t x) ∧
                        ∀ (x : Fin (2 ^ F.A)),
                          F.survival (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2) t x ≤ ↑vmax / ↑vmin * (↑Lu / ↑Mu) ^ t
Data.survival_up_sure : ∀ (c : Data) (F : Face) (V Gs : Gump.Dice.Tree) (L M K N vmin vmax : ℕ),
  c.tabOK F = true →
    Data.allRows (c.rowUp F.A (c.Dt F.A) L M V) (2 ^ F.A) = true →
      Data.allRows (c.rowLe F.A (c.Dt F.A) K N Gs V) (2 ^ F.A) = true →
        Data.vecOK2 V Gs F.A vmin vmax = true →
          0 < M →
            0 < N →
              0 < vmin →
                0 < L →
                  ∀ (t : ℕ) (x : Fin (2 ^ F.A)),
                    F.survival (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2) (t + 1) x ≤
                      (↑vmax / ↑vmin + ↑K / ↑N * ↑vmax / (↑L / ↑M)) * (↑L / ↑M) ^ (t + 1)
Data.qsd_bounds : ∀ (c : Data) (F : Face) (Vu Vl : Gump.Dice.Tree) (Lu Mu Ll Ml vmin vmax wmin wmax : ℕ),
  c.tabOK F = true →
    Data.allRows (c.rowUp F.A (c.Dt F.A) Lu Mu Vu) (2 ^ F.A) = true →
      Data.allRows (c.rowLo F.A (c.Dt F.A) Ll Ml Vl) (2 ^ F.A) = true →
