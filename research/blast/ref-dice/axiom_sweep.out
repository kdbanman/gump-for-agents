          Data.vecOK Vl F.A wmin wmax = true →
            0 < Mu →
              0 < Ml →
                0 < vmin →
                  0 < wmin →
                    ∀ (μ : Fin (2 ^ F.A) → ℝ) (lam : ℝ),
                      IsQSD F (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2) μ lam → ↑↑Ll / ↑Ml ≤ lam ∧ lam ≤ ↑↑Lu / ↑Mu
Data.qsd_lo_sure : ∀ (c : Data) (F : Face) (Vl : Gump.Dice.Tree) (Ll Ml wmax : ℕ),
  c.tabOK F = true →
    Data.allRows (c.rowLo F.A (c.Dt F.A) Ll Ml Vl) (2 ^ F.A) = true →
