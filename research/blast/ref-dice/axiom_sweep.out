Data.poisson_bound : ∀ (c : Data) (F : Face),
  c.tabOK F = true →
    ∀ (K : ℕ) (NK Wp Wm : Gump.Dice.Tree) (S : ℕ),
      0 < S →
        ∀ (p lam' eps om : ℚ),
          Data.allRows (c.poisRow F.A (c.Dt F.A) K NK Wp Wm S p lam' eps om) (2 ^ F.A) = true →
            Wp.get F.A 0 = 0 ∧ Wm.get F.A 0 = 0 →
              (∀ (v : Fin (2 ^ F.A)),
                  ↑(NK.get F.A ↑v) = ↑(c.Dt F.A) ^ K * F.noBust (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2) K v) →
                ∀ (μ : Fin (2 ^ F.A) → ℝ) (lam : ℝ),
                  IsQSD F (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2) μ lam →
                    |∑ x, μ x * ↑(F.noBust (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2) K x) - ↑p * (1 - lam)| ≤
                      (↑eps + |↑lam' - lam| * ↑om) * (1 - lam)
Data.rows_le : ∀ (c : Data) (F : Face),
  c.tabOK F = true →
    ∀ (U W : Gump.Dice.Tree) (L M : ℕ),
      0 < M →
        Data.allRows (c.rowLe F.A (c.Dt F.A) L M U W) (2 ^ F.A) = true →
          ∀ (x : Fin (2 ^ F.A)),
            (F.P (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2)).mulVec (Data.vec U F.A) x ≤ ↑L / ↑M * Data.vec W F.A x
Tree.eval_eq : ∀ (t : Gump.Dice.Tree) (n : ℕ) (f : ℕ → ℕ × ℕ),
  t.eval n f = ∑ y ∈ Finset.range (2 ^ n), (∏ i ∈ Finset.range n, Tree.sel (f i) (y.testBit i)) * t.get n y
Data.rows_of_reps : ∀ (c : Data) (F : Face),
  c.tabOK F = true →
    ∀ (gens : List (List ℕ × Gump.Dice.Tree)) (Wg Wr Rm : Gump.Dice.Tree),
      (∀ g ∈ gens, c.symOK F.A g.1 g.2 = true) →
        ∀ (U W : Gump.Dice.Tree),
          (∀ g ∈ gens, Data.invOK F.A g.2 U = true) →
            (∀ g ∈ gens, Data.invOK F.A g.2 W = true) →
              Data.repsOK F.A gens Wg Wr Rm = true →
                ∀ (R : ℚ → ℚ → Prop),
                  (∀ (x : Fin (2 ^ F.A)),
                      Rm.get F.A ↑x = 1 →
                        R ((F.P (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2)).mulVec (Data.vec U F.A) x) (Data.vec W F.A x)) →
                    ∀ (x : Fin (2 ^ F.A)),
                      R ((F.P (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2)).mulVec (Data.vec U F.A) x) (Data.vec W F.A x)
Data.P_sym : ∀ (c : Data) (F : Face),
  c.tabOK F = true →
    ∀ {σ : List ℕ} {I : Gump.Dice.Tree},
      c.symOK F.A σ I = true →
        ∀ (x y : Fin (2 ^ F.A)) (hx' : I.get F.A ↑x < 2 ^ F.A) (hy' : I.get F.A ↑y < 2 ^ F.A),
          F.P (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2) ⟨I.get F.A ↑x, hx'⟩ ⟨I.get F.A ↑y, hy'⟩ =
            F.P (↑c.n1 / ↑c.d1) (↑c.n2 / ↑c.d2) x y
